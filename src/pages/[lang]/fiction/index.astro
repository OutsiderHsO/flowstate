---
import Base from '../../../layouts/Base.astro';
import StoryCard from '../../../components/StoryCard.astro';
import { LANGS, type Lang } from '../../../lib/site';
import { t, GENRES, type GenreKey } from '../../../lib/i18n';
import { getFiction, entryHref, formatDate, wordCount, formatCount } from '../../../lib/articles';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const strings = t[lang];
const all = await getFiction(lang);
const other: Lang = lang === 'zh' ? 'en' : 'zh';

const activeGenre = Astro.url.searchParams.get('genre') as GenreKey | null;
const validGenre =
  activeGenre && (Object.keys(GENRES) as string[]).includes(activeGenre) ? activeGenre : null;

const list = validGenre ? all.filter((s) => s.data.genre === validGenre) : all;

/**
 * Group serials into one shelf entry.
 *
 * A 14-chapter novel is *one* work, not fourteen covers. Chapters keep
 * their own pages (linked from the table of contents) but the shelf shows
 * the series once, with a chapter list underneath.
 */
type ShelfItem =
  | { kind: 'story'; story: (typeof list)[number] }
  | { kind: 'series'; title: string; chapters: (typeof list)[number]; words: number };

const shelf: ShelfItem[] = [];
const seenSeries = new Set<string>();

for (const story of list) {
  const series = story.data.series;
  if (!series) {
    shelf.push({ kind: 'story', story });
    continue;
  }
  if (seenSeries.has(series)) continue;
  seenSeries.add(series);
  const chapters = list.filter((s) => s.data.series === series);
  shelf.push({
    kind: 'series',
    title: series,
    chapters: chapters[0],
    words: chapters.reduce((sum, c) => sum + wordCount(c.body ?? '', lang), 0),
  });
}

const serials = list.filter((s) => s.data.series);
const seriesChapters = new Map<string, typeof list>();
for (const s of serials) {
  const key = s.data.series!;
  if (!seriesChapters.has(key)) seriesChapters.set(key, []);
  seriesChapters.get(key)!.push(s);
}

const [featuredItem, ...rest] = shelf;

const filters: { key: string | null; label: string; count: number }[] = [
  { key: null, label: strings.labels.filterAll, count: shelf.length },
  ...(Object.keys(GENRES) as GenreKey[]).map((key) => ({
    key,
    label: GENRES[key][lang],
    count: shelf.filter((i) =>
      i.kind === 'story' ? i.story.data.genre === key : i.chapters.data.genre === key,
    ).length,
  })),
];

const filterHref = (key: string | null) =>
  key ? `/${lang}/fiction/?genre=${key}` : `/${lang}/fiction/`;

const totalWords = all.reduce((sum, s) => sum + wordCount(s.body ?? '', lang), 0);
---

<Base
  lang={lang}
  track="fiction"
  title={strings.nav.fiction}
  section="/fiction/"
  alternate={{ lang: other, href: `/${other}/fiction/` }}
>
  <section class="wrap shelf-head">
    <p class="eyebrow"><span class="idx">02</span> — {strings.nav.fiction}</p>
    <h1 class="shelf-head__title">{strings.fiction.shelf}</h1>
    <p class="shelf-head__stats mono">
      <span>{String(all.length).padStart(2, '0')} {lang === 'zh' ? '篇' : 'works'}</span>
      <span aria-hidden="true">/</span>
      <span>{formatCount(totalWords)} {lang === 'zh' ? '字' : 'words'}</span>
    </p>
  </section>

  <section class="wrap">
    <nav class="filters" aria-label={lang === 'zh' ? '按体裁筛选' : 'Filter by genre'}>
      <ul>
        {
          filters.map((f) => (
            <li>
              <a
                href={filterHref(f.key)}
                class:list={['filters__link', { 'is-active': f.key === validGenre }]}
                aria-current={f.key === validGenre ? 'true' : undefined}
              >
                {f.label}
                <span class="filters__count mono">{String(f.count).padStart(2, '0')}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      shelf.length === 0 ? (
        <p class="empty mono">{strings.labels.empty}</p>
      ) : (
        <>
          {featuredItem.kind === 'series' ? (
            <article class="spotlight">
              <div class="spotlight__link">
                <p class="eyebrow">
                  <span class="idx">01</span>
                  <span aria-hidden="true">—</span>
                  <span>{strings.sections.featured}</span>
                  <span class="tag-serial mono">
                    {GENRES[featuredItem.chapters.data.genre][lang]} ·{' '}
                    {seriesChapters.get(featuredItem.title)?.length ?? 0}
                    {lang === 'zh' ? ' 章' : ' ch'}
                  </span>
                </p>
                <h2 class="spotlight__title">{featuredItem.chapters.data.title}</h2>
                <p class="spotlight__logline">{featuredItem.chapters.data.dek}</p>
                <p class="spotlight__meta mono">
                  <span>{featuredItem.title}</span>
                  <span aria-hidden="true">/</span>
                  <span>
                    {formatCount(featuredItem.words)} {strings.fiction.wordCount}
                  </span>
                  <span aria-hidden="true">/</span>
                  <span>
                    {strings.fiction.rating} {featuredItem.chapters.data.rating}
                  </span>
                </p>
              </div>
              <ol class="toc-list">
                {seriesChapters.get(featuredItem.title)?.map((ch, i) => (
                  <li>
                    <a class="toc-list__row" href={entryHref(ch, 'fiction')}>
                      <span class="toc-list__num mono">{String(i + 1).padStart(2, '0')}</span>
                      <span class="toc-list__title">{ch.data.title}</span>
                      <span class="toc-list__meta mono">
                        {formatCount(wordCount(ch.body ?? '', lang))} {strings.fiction.wordCount}
                      </span>
                    </a>
                  </li>
                ))}
              </ol>
            </article>
          ) : (
            <article class="spotlight">
              <a class="spotlight__link" href={entryHref(featuredItem.story, 'fiction')}>
                <p class="eyebrow">
                  <span class="idx">01</span>
                  <span aria-hidden="true">—</span>
                  <span>{strings.sections.featured}</span>
                  {featuredItem.story.data.nature === 'fanwork' && (
                    <span class="tag-fan mono">{strings.fiction.fandom}</span>
                  )}
                </p>
                <h2 class="spotlight__title">{featuredItem.story.data.title}</h2>
                <p class="spotlight__logline">{featuredItem.story.data.dek}</p>
                <p class="spotlight__meta mono">
                  {featuredItem.story.data.fandom && (
                    <span class="spotlight__fandom">{featuredItem.story.data.fandom}</span>
                  )}
                  <span>{formatDate(featuredItem.story.data.published, lang)}</span>
                  <span aria-hidden="true">/</span>
                  <span>
                    {formatCount(wordCount(featuredItem.story.body ?? '', lang))}{' '}
                    {strings.fiction.wordCount}
                  </span>
                  <span aria-hidden="true">/</span>
                  <span>
                    {strings.fiction.rating} {featuredItem.story.data.rating}
                  </span>
                </p>
              </a>
            </article>
          )}

          {rest.length > 0 && (
            <div class="shelf-grid">
              {rest.map((item, i) =>
                item.kind === 'story' ? (
                  <StoryCard story={item.story} lang={lang} index={i + 2} />
                ) : (
                  <article class="series-card">
                    <a class="series-card__media" href={entryHref(item.chapters, 'fiction')}>
                      <span class="series-card__count mono">
                        {seriesChapters.get(item.title)?.length ?? 0}
                        {lang === 'zh' ? ' 章' : ' ch'}
                      </span>
                    </a>
                    <p class="eyebrow">
                      <span class="idx">{String(i + 2).padStart(2, '0')}</span>
                      <span aria-hidden="true">—</span>
                      <span>{GENRES[item.chapters.data.genre][lang]}</span>
                    </p>
                    <h3 class="series-card__title">
                      <a href={entryHref(item.chapters, 'fiction')} class="link-underline">
                        {item.title}
                      </a>
                    </h3>
                    <p class="series-card__meta mono">
                      {formatCount(item.words)} {strings.fiction.wordCount}
                    </p>
                  </article>
                ),
              )}
            </div>
          )}
        </>
      )
    }
  </section>
</Base>

<style>
  .shelf-head {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    padding-bottom: clamp(1.5rem, 3vw, 2.25rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 0.6rem 1rem;
  }

  @media (max-width: 520px) {
    .shelf-head {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .shelf-head .eyebrow {
    grid-column: 1 / -1;
  }

  .shelf-head__title {
    font-size: var(--step-3);
    letter-spacing: -0.04em;
    text-transform: uppercase;
    line-height: 1.04;
  }

  .shelf-head__stats {
    display: flex;
    gap: 0.45rem;
    font-size: 0.72rem;
    color: var(--ink-faint);
    padding-bottom: 0.35rem;
  }

  .filters {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem);
    overflow-x: auto;
  }

  .filters ul {
    display: flex;
    flex-wrap: wrap;
  }

  .filters__link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.8rem 0.95rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    border-bottom: 1px solid transparent;
    margin-bottom: -1px;
    white-space: nowrap;
    transition:
      color 200ms var(--ease),
      border-color 200ms var(--ease);
  }

  .filters__link:hover {
    color: var(--ink-strong);
  }

  .filters__link.is-active {
    color: var(--accent-bright);
    border-bottom-color: var(--accent);
  }

  .filters__count {
    font-size: 0.62rem;
    color: var(--ink-faint);
  }

  /* ---------------- spotlight ---------------- */
  .spotlight {
    border-bottom: 1px solid var(--line-strong);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .spotlight__link {
    display: grid;
    gap: 0.7rem;
    padding: clamp(1.5rem, 4vw, 2.75rem) 0.25rem;
    transition: background 300ms var(--ease);
  }

  .spotlight__link:hover {
    background: linear-gradient(90deg, var(--accent-wash), transparent 65%);
  }

  .spotlight__title {
    font-size: var(--step-3);
    letter-spacing: -0.035em;
    line-height: 1.06;
    max-width: 28ch;
    padding-bottom: 0.06em;
  }

  .spotlight__logline {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-muted);
    max-width: 52ch;
  }

  .spotlight__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    font-size: 0.68rem;
    color: var(--ink-faint);
  }

  .spotlight__fandom {
    color: var(--accent);
  }

  .tag-fan {
    padding: 0.05rem 0.35rem;
    border: 1px solid var(--accent-dim);
    color: var(--accent);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
  }

  /* ---------------- shelf grid ---------------- */
  .shelf-grid {
    display: grid;
    gap: clamp(1.75rem, 3.5vw, 2.75rem) clamp(1.25rem, 2.5vw, 2rem);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr));
    padding-bottom: 1rem;
  }

  .empty {
    padding: 3rem 0;
    color: var(--ink-faint);
  }

  /* ---------------- chapter table of contents ---------------- */
  .tag-serial {
    padding: 0.05rem 0.35rem;
    border: 1px solid var(--line-strong);
    color: var(--ink-muted);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
  }

  .toc-list {
    border-top: 1px solid var(--line);
  }

  .toc-list li {
    border-bottom: 1px solid var(--line);
  }

  .toc-list__row {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.9rem;
    padding: 0.62rem 0.25rem;
    transition:
      background 220ms var(--ease),
      padding-inline 220ms var(--ease);
  }

  .toc-list__row:hover {
    background: linear-gradient(90deg, var(--accent-wash), transparent 65%);
    padding-inline: 0.7rem 0.25rem;
  }

  .toc-list__num {
    font-size: 0.62rem;
    color: var(--ink-faint);
  }

  .toc-list__title {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    color: var(--ink);
    transition: color 200ms var(--ease);
  }

  .toc-list__row:hover .toc-list__title {
    color: var(--accent-bright);
  }

  .toc-list__meta {
    font-size: 0.6rem;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .toc-list__row {
      grid-template-columns: 1.8rem minmax(0, 1fr);
    }
    .toc-list__meta {
      grid-column: 2;
      padding-left: 0;
    }
  }

  /* ---------------- series card on the shelf ---------------- */
  .series-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .series-card__media {
    display: grid;
    place-items: end start;
    aspect-ratio: 3 / 4;
    padding: 0.7rem;
    border: 1px solid var(--line);
    background:
      linear-gradient(160deg, var(--surface-2), var(--bg-sunken)),
      var(--bg-sunken);
    transition: border-color 240ms var(--ease);
  }

  .series-card__media:hover {
    border-color: var(--accent-dim);
  }

  .series-card__count {
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: var(--accent);
  }

  .series-card__title {
    margin-top: 0.5rem;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.3;
    padding-bottom: 0.05em;
  }

  .series-card__meta {
    margin-top: 0.4rem;
    font-size: 0.62rem;
    color: var(--ink-faint);
  }
</style>
