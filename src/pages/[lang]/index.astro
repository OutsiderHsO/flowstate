---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import StoryCard from '../../components/StoryCard.astro';
import { LANGS, SITE, type Lang } from '../../lib/site';
import { t, GENRES } from '../../lib/i18n';
import {
  getAutomotive,
  getLeadAutomotive,
  getFiction,
  getLeadFiction,
  entryHref,
  formatDate,
  excerpt,
  wordCount,
  formatCount,
} from '../../lib/articles';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const strings = t[lang];

const [cars, carLead, stories, storyLead] = await Promise.all([
  getAutomotive(lang),
  getLeadAutomotive(lang),
  getFiction(lang),
  getLeadFiction(lang),
]);

const latestCars = cars.filter((a) => a.id !== carLead?.id).slice(0, 3);
const latestStories = stories.filter((s) => s.id !== storyLead?.id).slice(0, 3);

const isoDate = (d: Date) => d.toISOString().slice(0, 10);
---

<Base lang={lang} section="/">
  <section class="masthead wrap">
    <p class="eyebrow">
      <span class="idx">FS</span>
      <span aria-hidden="true">—</span>
      <span>{SITE.tagline[lang]}</span>
    </p>
    <h1 class="masthead__title">FLOWSTATE</h1>
    <p class="masthead__lede">{SITE.description[lang]}</p>
    <p class="masthead__sig mono">
      <span>{SITE.author.name}</span>
      <span aria-hidden="true">/</span>
      <span>{cars.length + stories.length} {lang === 'zh' ? '篇作品' : 'pieces'}</span>
    </p>
  </section>

  <div class="tracks wrap">
    <!-- ---------------------------------------------------------- automotive -->
    <section class="track track--automotive" aria-labelledby="track-cars">
      <a class="track__port" href={`/${lang}/automotive/`}>
        <span class="track__index mono">01</span>
        <span class="track__label">{strings.nav.automotive}</span>
        <span class="track__count mono">{String(cars.length).padStart(2, '0')}</span>
      </a>

      {
        carLead ? (
          <article class="lead">
            <a
              class="lead__media neon-frame"
              href={entryHref(carLead, 'automotive')}
              tabindex="-1"
              aria-hidden="true"
            >
              {carLead.data.image ? (
                <img
                  src={carLead.data.image}
                  alt={carLead.data.imageAlt ?? ''}
                  loading="eager"
                  decoding="async"
                />
              ) : (
                <span class="lead__placeholder" />
              )}
              <span class="lead__scrim" aria-hidden="true" />
              <span class="lead__stamp mono">{isoDate(carLead.data.published)}</span>
            </a>
            <div class="lead__body">
              <p class="eyebrow">
                <span class="idx">01</span>
                <span aria-hidden="true">—</span>
                <span>{strings.sections.featured}</span>
              </p>
              <h2 class="lead__title" id="track-cars">
                <a href={entryHref(carLead, 'automotive')} class="link-underline">
                  {carLead.data.title}
                </a>
              </h2>
              <p class="lead__dek">{carLead.data.dek}</p>
              <p class="lead__excerpt mono">{excerpt(carLead.body ?? '', 130)}</p>
            </div>
          </article>
        ) : (
          <div class="track__empty">
            <p class="mono">{strings.labels.empty}</p>
          </div>
        )
      }

      {
        latestCars.length > 0 && (
          <ul class="track__list">
            {latestCars.map((entry, i) => (
              <li>
                <a class="track__row" href={entryHref(entry, 'automotive')}>
                  <span class="track__row-num mono">{String(i + 2).padStart(2, '0')}</span>
                  <span class="track__row-title">{entry.data.title}</span>
                  <span class="track__row-date mono">{formatDate(entry.data.published, lang)}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <a class="track__more" href={`/${lang}/automotive/`}>
        {strings.sections.index}
        <span aria-hidden="true">→</span>
      </a>
    </section>

    <!-- ------------------------------------------------------------- fiction -->
    <section class="track track--fiction" aria-labelledby="track-fiction">
      <a class="track__port" href={`/${lang}/fiction/`}>
        <span class="track__index mono">02</span>
        <span class="track__label">{strings.nav.fiction}</span>
        <span class="track__count mono">{String(stories.length).padStart(2, '0')}</span>
      </a>

      {
        storyLead ? (
          <article class="lead">
            <a class="lead__media" href={entryHref(storyLead, 'fiction')} tabindex="-1" aria-hidden="true">
              {storyLead.data.image ? (
                <img
                  src={storyLead.data.image}
                  alt={storyLead.data.imageAlt ?? ''}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="lead__placeholder" />
              )}
              <span class="lead__scrim" aria-hidden="true" />
              <span class="lead__rating mono">{storyLead.data.rating}</span>
            </a>
            <div class="lead__body">
              <p class="eyebrow">
                <span class="idx">02</span>
                <span aria-hidden="true">—</span>
                <span>{GENRES[storyLead.data.genre][lang]}</span>
                {storyLead.data.nature === 'fanwork' && (
                  <span class="tag-fan mono">{strings.fiction.fandom}</span>
                )}
              </p>
              <h2 class="lead__title" id="track-fiction">
                <a href={entryHref(storyLead, 'fiction')} class="link-underline">
                  {storyLead.data.title}
                </a>
              </h2>
              <p class="lead__dek">{storyLead.data.dek}</p>
              <p class="lead__excerpt mono">
                {formatCount(wordCount(storyLead.body ?? '', lang))} {strings.fiction.wordCount}
                {storyLead.data.fandom ? ` · ${storyLead.data.fandom}` : ''}
              </p>
            </div>
          </article>
        ) : (
          <div class="track__empty">
            <p class="mono">{strings.labels.empty}</p>
          </div>
        )
      }

      {
        latestStories.length > 0 && (
          <ul class="track__list">
            {latestStories.map((story, i) => (
              <li>
                <a class="track__row" href={entryHref(story, 'fiction')}>
                  <span class="track__row-num mono">{String(i + 2).padStart(2, '0')}</span>
                  <span class="track__row-title">{story.data.title}</span>
                  <span class="track__row-date mono">{formatDate(story.data.published, lang)}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <a class="track__more" href={`/${lang}/fiction/`}>
        {strings.fiction.shelf}
        <span aria-hidden="true">→</span>
      </a>
    </section>
  </div>
</Base>

<style>
  /* ---------------- masthead ---------------- */
  .masthead {
    padding-top: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: clamp(1.75rem, 4vw, 3rem);
    display: grid;
    gap: 0.75rem;
  }

  .masthead__title {
    font-size: var(--step-4);
    font-weight: 900;
    letter-spacing: -0.05em;
    line-height: 1;
    text-transform: uppercase;
    padding-bottom: 0.04em;
    background: linear-gradient(100deg, var(--ink-strong) 20%, #9a9a9f 60%, var(--ink-strong));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .masthead__lede {
    max-width: 52ch;
    font-size: var(--step-1);
    line-height: 1.5;
    font-family: var(--font-serif);
    color: var(--ink-muted);
  }

  .masthead__sig {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.7rem;
    color: var(--ink-faint);
  }

  @media (max-width: 640px) {
    .masthead__title {
      font-size: clamp(2.6rem, 13vw, 4rem);
      letter-spacing: -0.03em;
    }
  }

  /* ---------------- two tracks ---------------- */
  .tracks {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  @media (min-width: 900px) {
    .tracks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(2rem, 4vw, 3.5rem);
    }
    /* A hairline between the two tracks, like a magazine spread fold.
       Drawn on the grid itself so it spans both columns' full height. */
    .track--fiction {
      position: relative;
      padding-left: clamp(2rem, 4vw, 3.5rem);
    }
    .track--fiction::before {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      width: 1px;
      background: var(--line);
    }
  }

  .track {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 0;
  }

  /* Track-specific accents reuse the page-level tokens. */
  .track--automotive {
    --track-accent: #c98b52;
    --track-accent-dim: #6d4a2c;
    --track-wash: rgba(201, 139, 82, 0.1);
  }

  .track--fiction {
    --track-accent: #8f9dd0;
    --track-accent-dim: #4a5477;
    --track-wash: rgba(143, 157, 208, 0.1);
  }

  .track__port {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.75rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--line-strong);
    transition: border-color 240ms var(--ease);
  }

  .track__port:hover {
    border-bottom-color: var(--track-accent-dim);
  }

  /* Neon underglow, automotive track only (the other track sets boost to 0). */
  .track--automotive .track__port {
    border-bottom-color: transparent;
    background-image: linear-gradient(90deg, var(--neon-a), var(--neon-b) 60%, transparent);
    background-repeat: no-repeat;
    background-size: 100% 1px;
    background-position: 0 100%;
  }

  .track--automotive .track__port:hover {
    box-shadow: 0 calc(6px * var(--neon-boost)) calc(22px * var(--neon-boost))
      calc(-6px * var(--neon-boost)) var(--neon-b-dim);
  }

  .track__index {
    font-size: 0.68rem;
    color: var(--track-accent);
  }

  /* The index numbers are the one permanently-lit element on the
     automotive track — small, so it reads as a pilot light. */
  .track--automotive .track__index {
    color: var(--neon-b);
    text-shadow: 0 0 calc(10px * var(--neon-boost)) rgba(34, 211, 238, calc(0.55 * var(--neon-boost)));
  }

  .track__label {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.2rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-strong);
  }

  .track__count {
    font-size: 0.68rem;
    color: var(--ink-faint);
  }

  /* ---------------- lead ---------------- */
  .lead {
    display: grid;
    gap: 0.9rem;
  }

  .lead__media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .track--fiction .lead__media {
    aspect-ratio: 3 / 2;
  }

  /* Stories read as books: a portrait cover, not a photo crop. */
  .track--fiction .lead {
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    align-items: start;
    gap: 1.25rem;
  }

  .track--fiction .lead__media {
    aspect-ratio: 3 / 4;
  }

  .track--fiction .lead__body {
    padding-top: 0.15rem;
  }

  @media (max-width: 620px) {
    .track--fiction .lead {
      grid-template-columns: minmax(0, 1fr);
    }
    .track--fiction .lead__media {
      aspect-ratio: 3 / 2;
    }
  }

  .lead__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.72) contrast(1.06) brightness(0.9);
    transition: transform 1s var(--ease);
  }

  .lead:hover .lead__media img {
    transform: scale(1.025);
  }

  .lead__placeholder {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--line-faint) 1px, transparent 1px),
      linear-gradient(90deg, var(--line-faint) 1px, transparent 1px);
    background-size: 36px 36px;
  }

  .lead__scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(130% 100% at 50% 45%, transparent 42%, rgba(0, 0, 0, 0.6) 100%),
      linear-gradient(to top, rgba(0, 0, 0, 0.5), transparent 60%);
  }

  .lead__stamp,
  .lead__rating {
    position: absolute;
    bottom: 0.6rem;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.7);
  }

  .lead__stamp {
    right: 0.7rem;
  }

  .lead__rating {
    left: 0.7rem;
    padding: 0.1rem 0.35rem;
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #fff;
  }

  .lead__body {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
  }

  .lead__title {
    font-size: var(--step-2);
    line-height: 1.1;
    letter-spacing: -0.03em;
    padding-bottom: 0.05em;
  }

  .track--fiction .lead__title {
    font-family: var(--font-serif);
    font-weight: 600;
    letter-spacing: -0.005em;
  }

  .lead__dek {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--ink-muted);
    max-width: 44ch;
  }

  .lead__excerpt {
    font-size: 0.68rem;
    line-height: 1.6;
    color: var(--ink-faint);
    max-width: 48ch;
  }

  .tag-fan {
    padding: 0.05rem 0.35rem;
    border: 1px solid var(--track-accent-dim, var(--accent-dim));
    color: var(--track-accent, var(--accent));
    font-size: 0.56rem;
    letter-spacing: 0.1em;
  }

  /* ---------------- latest rows ---------------- */
  .track__list {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .track__list li {
    border-bottom: 1px solid var(--line);
  }

  .track__row {
    display: grid;
    grid-template-columns: 1.6rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.7rem 0.2rem;
    transition:
      background 240ms var(--ease),
      padding-inline 240ms var(--ease);
  }

  .track__row:hover {
    background: linear-gradient(90deg, var(--track-wash), transparent 70%);
    padding-inline: 0.6rem 0.2rem;
  }

  .track__row-num {
    font-size: 0.62rem;
    color: var(--ink-faint);
  }

  .track__row-title {
    font-size: 0.88rem;
    line-height: 1.35;
    color: var(--ink);
    transition: color 200ms var(--ease);
  }

  .track__row:hover .track__row-title {
    color: var(--track-accent);
  }

  .track__row-date {
    font-size: 0.6rem;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  @media (max-width: 420px) {
    .track__row {
      grid-template-columns: 1.6rem minmax(0, 1fr);
    }
    .track__row-date {
      display: none;
    }
  }

  .track__more {
    align-self: flex-start;
    margin-top: auto;
    padding-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
    transition: color 200ms var(--ease);
  }

  .track__more:hover {
    color: var(--track-accent);
  }

  .track__empty {
    padding: 2rem 0;
    color: var(--ink-faint);
  }
</style>
