---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { LANGS, SITE, type Lang } from '../../lib/site';
import { t, CATEGORIES, type CategoryKey } from '../../lib/i18n';
import {
  getArticles,
  getLead,
  articleHref,
  formatDate,
  readingTime,
} from '../../lib/articles';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const strings = t[lang];

const [all, lead] = await Promise.all([getArticles(lang), getLead(lang)]);
const rest = all.filter((a) => a.id !== lead?.id);
const [primary, ...secondary] = rest;

const categories = (Object.keys(CATEGORIES) as CategoryKey[]).map((key) => {
  const items = all.filter((a) => a.data.category === key);
  return { key, label: CATEGORIES[key][lang], count: items.length, latest: items[0] };
});

/**
 * Turn Markdown into a short plain-text dek for the cover slot.
 * Skips headings, tables, code and quote markers so the teaser reads
 * like prose rather than leaked markup.
 */
function excerpt(body: string, max = 220): string {
  const paragraphs = body
    .replace(/^---[\s\S]*?---/, '')
    .replace(/```[\s\S]*?```/g, '')
    .split(/\n\s*\n/)
    .map((p) => p.trim())
    .filter((p) => p && !/^(#|>|\||!\[|[-*+]\s|\d+\.\s)/.test(p));

  const clean = (paragraphs[0] ?? '')
    .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/[*_`]/g, '')
    .replace(/\s+/g, ' ')
    .trim();

  if (clean.length <= max) return clean;
  const cut = clean.slice(0, max);
  const lastSpace = cut.lastIndexOf(' ');
  return `${(lastSpace > max * 0.6 ? cut.slice(0, lastSpace) : cut).trimEnd()}…`;
}

const featuredRead = lead ? readingTime(lead.body ?? '', lang) : 0;
const isoDate = (d: Date) => d.toISOString().slice(0, 10);
---

<Base lang={lang} section="/">
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero__meta">
      <span class="eyebrow"><span class="idx">00</span> — {strings.sections.issue}</span>
      <span class="mono hero__stamp">
        {
          Array.from({ length: 11 }).map((_, i) => (
            <span class="hero__tick" aria-hidden="true" />
          ))
        }
        <span class="visually-hidden">Est. 2026</span>
      </span>
    </div>

    <div class="hero__statement">
      <h1 id="hero-title" class="hero__title">
        <span class="hero__title-line">{lang === 'zh' ? '机械、街道' : 'Machines,'}</span>
        <span class="hero__title-line hero__title-line--accent">
          {lang === 'zh' ? '与驾驶者的' : 'streets'}
        </span>
        <span class="hero__title-line">{lang === 'zh' ? '个人笔记' : '& the people who drive them'}</span>
      </h1>
      <p class="hero__lede">{SITE.description[lang]}</p>
    </div>
  </section>

  {
    lead && (
      <section class="cover wrap" aria-labelledby="cover-title">
        <a class="cover__media" href={articleHref(lead)} tabindex="-1" aria-hidden="true">
          {lead.data.image ? (
            <img src={lead.data.image} alt={lead.data.imageAlt ?? ''} fetchpriority="high" decoding="async" />
          ) : (
            <div class="cover__placeholder">
              <div class="cover__grid" aria-hidden="true" />
            </div>
          )}
          <span class="cover__scrim" aria-hidden="true" />
          <span class="cover__corner mono" aria-hidden="true">
            <span>[ F-001 ]</span>
            <span>{isoDate(lead.data.published)}</span>
          </span>
        </a>

        <div class="cover__body">
          <p class="eyebrow">
            <span class="idx">01</span>
            <span aria-hidden="true">—</span>
            <span>{strings.sections.featured}</span>
          </p>
          <h2 id="cover-title" class="cover__title">
            <a href={articleHref(lead)} class="link-underline">{lead.data.title}</a>
          </h2>
          <p class="cover__dek">{lead.data.dek}</p>
          <p class="cover__excerpt">{excerpt(lead.body ?? '')}</p>
          <p class="cover__facts mono">
            <span>{CATEGORIES[lead.data.category][lang]}</span>
            <span aria-hidden="true">/</span>
            <span>{formatDate(lead.data.published, lang)}</span>
            <span aria-hidden="true">/</span>
            <span>{featuredRead} {strings.labels.minRead}</span>
          </p>
          <a class="btn" href={articleHref(lead)}>
            {strings.labels.readMore}
            <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    )
  }

  {
    rest.length > 0 && (
      <section class="latest wrap" aria-labelledby="latest-title">
        <header class="section-head">
          <h2 id="latest-title" class="section-head__title">{strings.sections.latest}</h2>
          <a class="section-head__link mono" href={`/${lang}/journal/`}>
            {strings.sections.index} <span aria-hidden="true">→</span>
          </a>
        </header>

        <div class="grid">
          {primary && <ArticleCard article={primary} lang={lang} index={2} />}
          {secondary.slice(0, 4).map((entry, i) => (
            <ArticleCard article={entry} lang={lang} index={i + 3} variant="compact" />
          ))}
        </div>
      </section>
    )
  }

  <section class="sections wrap" aria-labelledby="sections-title">
    <header class="section-head">
      <h2 id="sections-title" class="section-head__title">{strings.sections.categories}</h2>
    </header>
    <ul class="sections__list">
      {
        categories.map((cat, i) => (
          <li class="sections__item">
            <a href={`/${lang}/journal/?category=${cat.key}`} class="sections__link">
              <span class="sections__num mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="sections__name">{cat.label}</span>
              <span class="sections__count mono">{String(cat.count).padStart(2, '0')}</span>
              <span class="sections__arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  /* ---------------- hero ---------------- */
  .hero {
    padding-top: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .hero__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--line);
  }

  .hero__stamp {
    display: inline-flex;
    align-items: flex-end;
    gap: 3px;
    height: 18px;
  }

  .hero__tick {
    display: block;
    width: 2px;
    height: 6px;
    background: var(--line-strong);
  }

  .hero__tick:nth-child(3n) {
    height: 12px;
    background: var(--ink-faint);
  }

  .hero__tick:nth-child(5) {
    height: 16px;
    background: var(--accent);
  }

  .hero__statement {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
    padding-top: clamp(1.75rem, 4vw, 3rem);
  }

  .hero__title {
    font-size: var(--step-4);
    font-weight: 900;
    line-height: 1.04;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    /* Long words must break rather than push the layout wide on small screens. */
    overflow-wrap: break-word;
    hyphens: auto;
    max-width: 100%;
    padding-bottom: 0.06em;
  }

  .hero__title-line {
    display: block;
    max-width: 100%;
  }

  .hero__title-line--accent {
    color: var(--accent);
  }

  .hero__lede {
    max-width: 44ch;
    color: var(--ink-muted);
    font-size: var(--step-1);
    line-height: 1.5;
    font-family: var(--font-serif);
    letter-spacing: 0.005em;
  }

  /* Keep the statement headline inside the viewport on phones. */
  @media (max-width: 640px) {
    .hero__title {
      font-size: clamp(2rem, 9.5vw, 3rem);
      letter-spacing: -0.03em;
      line-height: 1;
    }
  }

  @media (min-width: 900px) {
    .hero__statement {
      grid-template-columns: 1.55fr 1fr;
      align-items: end;
    }
    .hero__lede {
      text-align: right;
      justify-self: end;
      padding-bottom: 0.5rem;
    }
  }

  /* ---------------- cover story ---------------- */
  .cover {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding-block: clamp(1rem, 3vw, 2rem);
    border-top: 1px solid var(--line);
  }

  .cover__media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .cover__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.8) contrast(1.08) brightness(0.9);
    transition: transform 1.1s var(--ease);
  }

  .cover:hover .cover__media img {
    transform: scale(1.025);
  }

  .cover__scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(130% 100% at 50% 45%, transparent 40%, rgba(0, 0, 0, 0.6) 100%),
      linear-gradient(to top right, rgba(0, 0, 0, 0.55), transparent 60%);
  }

  .cover__corner {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    justify-content: space-between;
    padding: 0.75rem 0.9rem;
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.72);
  }

  .cover__placeholder {
    position: absolute;
    inset: 0;
    background: var(--bg-sunken);
  }

  .cover__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--line-faint) 1px, transparent 1px),
      linear-gradient(90deg, var(--line-faint) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: radial-gradient(70% 70% at 50% 50%, #000 20%, transparent 80%);
  }

  .cover__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .cover__title {
    font-size: var(--step-3);
    line-height: 1.06;
    letter-spacing: -0.035em;
    padding-bottom: 0.06em;
  }

  .cover__dek {
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--ink);
    max-width: 40ch;
  }

  .cover__excerpt {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--ink-muted);
    max-width: 52ch;
  }

  .cover__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--ink-faint);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.4rem;
    padding: 0.62rem 1.05rem;
    border: 1px solid var(--line-strong);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    background: transparent;
    transition:
      border-color 220ms var(--ease),
      background 220ms var(--ease),
      color 220ms var(--ease);
  }

  .btn:hover {
    border-color: var(--accent);
    background: var(--accent-wash);
    color: var(--accent-bright);
  }

  .btn__arrow {
    transition: transform 280ms var(--ease);
  }

  .btn:hover .btn__arrow {
    transform: translateX(4px);
  }

  @media (min-width: 900px) {
    .cover {
      grid-template-columns: 1.6fr 1fr;
      align-items: center;
    }
    .cover__media {
      aspect-ratio: 4 / 3;
    }
  }

  /* ---------------- section head ---------------- */
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.8rem;
    margin-bottom: clamp(1.25rem, 2.5vw, 1.75rem);
    border-bottom: 1px solid var(--line);
  }

  .section-head__title {
    font-size: clamp(1.05rem, 0.9rem + 0.7vw, 1.3rem);
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .section-head__link {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
    transition: color 200ms var(--ease);
  }

  .section-head__link:hover {
    color: var(--accent-bright);
  }

  /* ---------------- latest grid ---------------- */
  .latest {
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--line);
  }

  .grid {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
  }

  .grid > :first-child {
    grid-column: 1 / -1;
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .grid > :first-child {
      grid-column: span 2;
      grid-row: span 2;
    }
  }

  /* ---------------- sections index ---------------- */
  .sections {
    padding-block: clamp(2rem, 4vw, 3rem) 1rem;
  }

  .sections__item {
    border-bottom: 1px solid var(--line);
  }

  .sections__item:first-child {
    border-top: 1px solid var(--line);
  }

  .sections__link {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto 1.5rem;
    align-items: center;
    gap: 1rem;
    padding: clamp(0.9rem, 2vw, 1.25rem) 0.25rem;
    transition: background 240ms var(--ease), padding-inline 240ms var(--ease);
  }

  .sections__link:hover {
    background: linear-gradient(90deg, var(--accent-wash), transparent 60%);
    padding-inline: 0.85rem 0.25rem;
  }

  .sections__num {
    font-size: 0.7rem;
    color: var(--ink-faint);
  }

  .sections__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-1);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    transition: color 200ms var(--ease);
  }

  .sections__link:hover .sections__name {
    color: var(--accent-bright);
  }

  .sections__count {
    font-size: 0.7rem;
    color: var(--ink-faint);
  }

  .sections__arrow {
    font-size: 0.85rem;
    color: var(--ink-faint);
    transition: transform 240ms var(--ease), color 200ms var(--ease);
  }

  .sections__link:hover .sections__arrow {
    transform: translate(2px, -2px);
    color: var(--accent);
  }
</style>
