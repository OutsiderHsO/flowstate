---
import Base from '../../../layouts/Base.astro';
import { LANGS, SITE, type Lang } from '../../../lib/site';
import { t } from '../../../lib/i18n';
import { getAutomotive, getFiction } from '../../../lib/articles';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const strings = t[lang];
const other: Lang = lang === 'zh' ? 'en' : 'zh';

const [cars, stories] = await Promise.all([getAutomotive(lang), getFiction(lang)]);

const copy = {
  zh: {
    title: '关于本站',
    lead: 'FLOWSTATE 是我的个人站点，由两条线组成：一条讨论汽车，一条写虚构。它们看起来无关，其实共享同一种执念——把一件事拆开、看清楚，再重新组装。',
    tracks: [
      {
        num: '01',
        name: '汽车',
        desc: '改装研究中读到的资料、驾驶时的体感、车辆的横向对比。不追快讯，不做充值首试，每篇尽量回答一个具体问题。',
        count: `${cars.length} 篇`,
        href: `/${lang}/automotive/`,
      },
      {
        num: '02',
        name: '文学',
        desc: '短篇小说与同人文。有原创，也有基于已面世的角色和世界的再创作；后者都会标注来源并附非商业声明。',
        count: `${stories.length} 篇`,
        href: `/${lang}/fiction/`,
      },
    ],
    fanNote:
      '关于同人作品：本站同人内容均为非商业创作，角色与世界观版权归原作者及权利方所有。依内容分级在作品页标注，请按标示阅读。',
    colophon: [
      ['技术栈', 'Astro · TypeScript · Markdown · CSS'],
      ['托管', '静态站点，无数据库、无登录、无评论'],
      ['成本', '零预算：免费托管 + 开源工具'],
      ['语言', '中文 / English（部分作品仅有原文）'],
    ],
    note: '示例内容为占位文本，用于展示版式，不代表真实测评或已发表作品。',
  },
  en: {
    title: 'About',
    lead: 'FLOWSTATE is a personal site in two lines: one about cars, one about fiction. They look unrelated, but they share one habit — taking something apart, looking at it properly, and putting it back together.',
    tracks: [
      {
        num: '01',
        name: 'Cars',
        desc: 'Research from modification projects, what cars actually feel like, side-by-side comparisons. No news chases, no sponsored first drives.',
        count: `${cars.length} pieces`,
        href: `/${lang}/automotive/`,
      },
      {
        num: '02',
        name: 'Fiction',
        desc: 'Short stories and fan fiction. Some original, some built on existing characters and worlds — the latter are always labelled, with a non-commercial notice.',
        count: `${stories.length} works`,
        href: `/${lang}/fiction/`,
      },
    ],
    fanNote:
      'On fan works: everything here is non-commercial. Characters and settings belong to their original creators and rights holders. Ratings are shown on each story — please read accordingly.',
    colophon: [
      ['Stack', 'Astro · TypeScript · Markdown · CSS'],
      ['Hosting', 'Static site — no database, no accounts, no comments'],
      ['Cost', 'Zero budget: free hosting + open source'],
      ['Languages', '中文 / English — some pieces are single-language'],
    ],
    note: 'Sample content is placeholder text for layout purposes — not a real review or a published work.',
  },
}[lang];
---

<Base
  lang={lang}
  track="about"
  title={strings.nav.about}
  section="/about/"
  alternate={{ lang: other, href: `/${other}/about/` }}
>
  <section class="wrap about">
    <p class="eyebrow"><span class="idx">03</span> — {strings.nav.about}</p>
    <h1 class="about__title">{copy.title}</h1>
    <p class="about__lead">{copy.lead}</p>

    <p class="about__sig mono">
      <span>{SITE.author.name}</span>
    </p>

    <ul class="tracks-list">
      {
        copy.tracks.map((tr) => (
          <li class="tracks-list__item">
            <a class="tracks-list__link" href={tr.href}>
              <span class="tracks-list__num mono">{tr.num}</span>
              <span class="tracks-list__body">
                <span class="tracks-list__name">{tr.name}</span>
                <span class="tracks-list__desc">{tr.desc}</span>
              </span>
              <span class="tracks-list__count mono">{tr.count}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="about__note">{copy.fanNote}</p>

    <section class="colophon" aria-labelledby="colophon-title">
      <h2 id="colophon-title" class="colophon__title">{strings.sections.colophon}</h2>
      <dl class="colophon__list">
        {
          copy.colophon.map(([k, v]) => (
            <div class="colophon__row">
              <dt class="mono">{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <p class="about__placeholder mono">{copy.note}</p>
  </section>
</Base>

<style>
  .about {
    max-width: 980px;
    margin-inline: auto;
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .about__title {
    margin-top: 0.8rem;
    font-size: var(--step-3);
    letter-spacing: -0.04em;
    text-transform: uppercase;
    line-height: 1.04;
  }

  .about__lead {
    margin-top: 1.25rem;
    font-family: var(--font-serif);
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--ink-muted);
    max-width: 56ch;
  }

  .about__sig {
    margin-top: 1rem;
    font-size: 0.75rem;
    color: var(--accent);
  }

  .tracks-list {
    margin-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
  }

  .tracks-list__item {
    border-bottom: 1px solid var(--line);
  }

  .tracks-list__link {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    align-items: start;
    gap: 1rem;
    padding: 1.1rem 0.25rem;
    transition:
      background 240ms var(--ease),
      padding-inline 240ms var(--ease);
  }

  .tracks-list__link:hover {
    background: linear-gradient(90deg, var(--accent-wash), transparent 65%);
    padding-inline: 0.85rem 0.25rem;
  }

  .tracks-list__num {
    font-size: 0.7rem;
    color: var(--ink-faint);
    padding-top: 0.2rem;
  }

  .tracks-list__body {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }

  .tracks-list__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-1);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--ink-strong);
  }

  .tracks-list__desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--ink-muted);
    max-width: 52ch;
  }

  .tracks-list__count {
    font-size: 0.68rem;
    color: var(--ink-faint);
    padding-top: 0.25rem;
    white-space: nowrap;
  }

  .about__note {
    margin-top: 1.75rem;
    padding: 0.8rem 0.9rem;
    border-left: 2px solid var(--accent-dim);
    background: var(--accent-wash);
    font-size: 0.76rem;
    line-height: 1.7;
    color: var(--ink-muted);
  }

  .colophon {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    border-top: 1px solid var(--line);
    padding-top: 1.25rem;
  }

  .colophon__title {
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .colophon__list {
    margin: 0;
  }

  .colophon__row {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
  }

  .colophon__row dt {
    font-size: 0.72rem;
    color: var(--ink-faint);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .colophon__row dd {
    margin: 0;
    font-size: 0.9rem;
  }

  .about__placeholder {
    margin-top: 1.5rem;
    font-size: 0.68rem;
    color: var(--ink-faint);
  }

  @media (max-width: 520px) {
    .colophon__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.2rem;
    }
    .tracks-list__link {
      grid-template-columns: 1.6rem minmax(0, 1fr);
    }
    .tracks-list__count {
      grid-column: 2;
      padding-top: 0;
    }
  }
</style>
