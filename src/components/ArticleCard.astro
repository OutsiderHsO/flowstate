---
import type { AutomotiveEntry } from '../lib/articles';
import { entryHref, entrySlug, formatDate } from '../lib/articles';
import { CATEGORIES } from '../lib/i18n';
import type { Lang } from '../lib/site';

interface Props {
  article: AutomotiveEntry;
  lang: Lang;
  /** index number shown in the eyebrow, e.g. 02 */
  index: number;
  variant?: 'default' | 'compact';
}

const { article, lang, index, variant = 'default' } = Astro.props;
const { data } = article;
const href = entryHref(article, 'automotive');
const pad = String(index).padStart(2, '0');
---

<article class:list={['card', `card--${variant}`]}>
  <a class="card__media" href={href} tabindex="-1" aria-hidden="true">
    {
      data.image ? (
        <img src={data.image} alt={data.imageAlt ?? ''} loading="lazy" decoding="async" />
      ) : (
        <div class="card__placeholder" data-slug={entrySlug(article)}>
          <span class="card__placeholder-mark mono">{pad}</span>
        </div>
      )
    }
    <span class="card__vignette" aria-hidden="true"></span>
  </a>

  <div class="card__body">
    <p class="eyebrow">
      <span class="idx">{pad}</span>
      <span aria-hidden="true">—</span>
      <span>{CATEGORIES[data.category][lang]}</span>
      <span class="card__date mono">{formatDate(data.published, lang)}</span>
    </p>

    <h3 class="card__title">
      <a href={href} class="link-underline">{data.title}</a>
    </h3>

    {variant === 'default' && <p class="card__dek">{data.dek}</p>}
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .card__media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.82) contrast(1.06) brightness(0.92);
    transition:
      transform 900ms var(--ease),
      filter 500ms var(--ease);
  }

  .card:hover .card__media img {
    transform: scale(1.035);
    filter: saturate(0.95) contrast(1.05) brightness(1);
  }

  .card__vignette {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 90% at 50% 40%, transparent 45%, rgba(0, 0, 0, 0.55) 100%),
      linear-gradient(to top, rgba(0, 0, 0, 0.65), transparent 55%);
    pointer-events: none;
  }

  /* Image-free placeholder: a quiet technical grid, no car iconography */
  .card__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background-color: var(--surface);
    background-image:
      linear-gradient(var(--line-faint) 1px, transparent 1px),
      linear-gradient(90deg, var(--line-faint) 1px, transparent 1px);
    background-size: 28px 28px;
    background-position: center;
  }

  .card__placeholder-mark {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: var(--ink-faint);
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--line-strong);
    background: var(--bg);
  }

  .card__body {
    padding-top: 0.9rem;
  }

  .card__date {
    margin-left: auto;
    font-size: 0.64rem;
    color: var(--ink-faint);
  }

  .card__title {
    margin-top: 0.55rem;
    font-size: var(--step-1);
    line-height: 1.2;
    letter-spacing: -0.02em;
    padding-bottom: 0.04em;
  }

  .card__dek {
    margin-top: 0.55rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--ink-muted);
    max-width: 46ch;
  }

  .card--compact .card__media {
    aspect-ratio: 3 / 2;
  }

  .card--compact .card__title {
    font-size: 1rem;
    line-height: 1.3;
  }
</style>
